# Copia este archivo a ".env" y completa tus propios valores.
# El archivo ".env" real NUNCA debe subirse a git (ya está en .gitignore).

# Clave secreta de Flask (usada para firmar la sesión). Genera una aleatoria, por ejemplo:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=changeme

# Firebase Realtime Database
FIREBASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
FIREBASE_USER_ID=tu_user_id
FIREBASE_DEVICE_ID=tu_device_id

# Ruta al archivo de credenciales de Firebase Admin SDK (descargado desde
# Firebase Console > Configuración del proyecto > Cuentas de servicio).
# Este archivo JSON tampoco debe subirse a git.
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Cuenta de Firebase Authentication usada por el JS del cliente (dashboard/rawdata)
# para leer Realtime Database desde el navegador. Créala en Firebase Console >
# Authentication > Users, y usa una contraseña fuerte (no la reutilices).
FIREBASE_DEVICE_AUTH_EMAIL=device@example.com
FIREBASE_DEVICE_AUTH_PASSWORD=changeme

# Usuario de demostración para el login (solo para pruebas locales)
DEMO_USER_EMAIL=demo@demo.com
DEMO_USER_PASSWORD=changeme
DEMO_USER_NAME=Usuario Demo
